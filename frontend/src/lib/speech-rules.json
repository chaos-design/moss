  "formats": {
    "default": "mp3",
    "routeAllowed": ["mp3", "opus", "aac", "flac", "wav", "pcm"],
    "adapterSupported": {
      "mp3": {
        "outputFormat": "mp3_44100_128",
        "contentType": "audio/mpeg",
        "sampleRate": 44100
      },
      "opus": {
        "outputFormat": "opus_48000_128",
        "contentType": "audio/ogg",
        "sampleRate": 48000
      },
      "pcm": { "outputFormat": "pcm_16000", "contentType": "audio/pcm", "sampleRate": 16000 },
      "wav": { "outputFormat": "wav_44100", "contentType": "audio/wav", "sampleRate": 44100 }
    },
    "fishAudioSupported": {
      "mp3": { "outputFormat": "mp3", "contentType": "audio/mpeg", "sampleRate": 44100 },
      "opus": { "outputFormat": "opus", "contentType": "audio/ogg", "sampleRate": 48000 },
      "pcm": { "outputFormat": "pcm", "contentType": "audio/pcm", "sampleRate": 44100 },
      "wav": { "outputFormat": "wav", "contentType": "audio/wav", "sampleRate": 44100 }
    }
  },
  "localServices": {
    "asr": [
      {
        "id": "moss-asr",
        "label": "本机 ASR 服务",
        "endpoint": "ws://127.0.0.1:5580/v1/asr/stream",
        "transport": "local",
        "engines": ["qwen3-asr", "sensevoice"]
      },
      {
        "id": "funasr",
        "label": "FunASR（外部）",
        "endpoint": "ws://127.0.0.1:10095",
        "transport": "local",
        "engines": ["funasr"]
      },
      {
        "id": "local-api",
        "label": "本机 local 接口（ElevenLabs 适配器）",
        "endpoint": "http://127.0.0.1:5583/v1",
        "transport": "api",
        "modelSource": "localApi"
      },
      {
        "id": "fish-audio",
        "label": "Fish Audio 适配器",
        "endpoint": "http://127.0.0.1:5584/v1",
        "transport": "api",
        "modelSource": "fishAudio"
      }
    ],
    "tts": [
      {
        "id": "moss-tts",
        "label": "本机 TTS 网关",
        "endpoint": "http://127.0.0.1:5578",
        "transport": "local",
        "voices": "gateway"
      },
      {
        "id": "local-api",
        "label": "本机 local 接口（ElevenLabs 适配器）",
        "endpoint": "http://127.0.0.1:5583/v1",
        "transport": "api",
        "modelSource": "localApi",
        "voices": "elevenlabs"
      },
      {
        "id": "fish-audio",
        "label": "Fish Audio 适配器",
        "endpoint": "http://127.0.0.1:5584/v1",
        "transport": "api",
        "modelSource": "fishAudio",
        "voices": "fishaudio"
      }
    ]
  },
  "limits": {
    "maxTtsTextLength": 2000,
    "maxAsrAudioBytes": 8000000,
    "maxSpeechRequestBytes": 64000,
    "maxEndpointLength": 300,
    "maxApiKeyLength": 400,
    "maxModelLength": 120,
    "maxVoiceLength": 120,
    "speechRequestTimeoutMs": 30000,
    "adapterTimeoutSeconds": 45,
    "ttsRateLimitPerMinute": 240
  },
  "speed": { "min": 0.5, "max": 2, "providerMin": 0.7, "providerMax": 1.2, "default": 1 },
  "fishAudio": {
    "latency": "balanced",
    "defaultVoice": "",
    "voiceAliases": {
      "alloy": "",
      "echo": "",
      "fable": "",
      "onyx": "",
      "nova": "",
      "shimmer": ""
    },
    "speed": { "min": 0.5, "max": 2 }
  },
  "testSynthesis": {
    "text": "Moss 语音接口测试成功。",
    "voice": "alloy",
    "format": "mp3",
    "speed": 1,
    "minimumAudioBytes": 4,
    "contentTypePrefix": "audio/"
  }
}
