{
  "version": 1,
  "loopbackHosts": ["127.0.0.1", "localhost", "::1"],
  "allowedProtocols": ["http:", "https:", "ws:", "wss:"],
  "services": {
    "frontend": {
      "port": 5577,
      "origin": "http://localhost:5577",
      "routes": {
        "asrProxy": "/api/speech/asr",
        "ttsProxy": "/api/speech/tts",
        "ttsTest": "/api/speech/tts/test"
      }
    },
    "ttsGateway": {
      "port": 5578,
      "url": "http://127.0.0.1:5578",
      "routes": {
        "health": "/health",
        "prepare": "/v1/tts/prepare",
        "synthesize": "/v1/tts/synthesize"
      }
    },
    "asr": {
      "port": 5580,
      "url": "ws://127.0.0.1:5580/v1/asr/stream",
      "routes": { "health": "/health", "stream": "/v1/asr/stream" }
    },
    "cosyvoiceSidecar": { "port": 5581, "url": "http://127.0.0.1:5581" },
    "audio8Sidecar": { "port": 5582, "url": "http://127.0.0.1:5582" },
    "localApi": {
      "port": 5583,
      "baseUrl": "http://127.0.0.1:5583/v1",
      "routes": {
        "health": "/health",
        "speech": "/audio/speech",
        "speechTest": "/audio/speech/test",
        "transcriptions": "/audio/transcriptions"
      }
    },
    "fishAudio": {
      "port": 5584,
      "baseUrl": "http://127.0.0.1:5584/v1",
      "routes": {
        "health": "/health",
        "speech": "/audio/speech",
        "speechTest": "/audio/speech/test",
        "transcriptions": "/audio/transcriptions"
      }
    }
  },
  "models": {
    "localApi": { "tts": "eleven_flash_v2_5", "asr": "scribe_v2" },
    "remoteApi": { "tts": "tts-1", "asr": "whisper-1" },
    "fishAudio": { "tts": "s2.1-pro-free", "asr": "transcribe-1-pro" },
    "localApiTtsOptions": [
      "eleven_flash_v2_5",
      "eleven_v4",
      "eleven_multilingual_v2",
      "eleven_v3"
    ],
    "localApiAsrOptions": ["scribe_v2"],
    "fishAudioTtsOptions": ["s2.1-pro-free"],
    "fishAudioAsrOptions": ["transcribe-1-pro"],
    "ttsGatewayEngines": ["kokoro", "audio8", "cosyvoice"],
    "asrEngines": ["qwen3-asr", "sensevoice"],
    "localModelIds": {
      "kokoro": "kokoro-v1.0.onnx",
      "kokoroZh": "kokoro-v1.1-zh.onnx",
      "audio8": "Audio8/Audio8-TTS-Preview-0.6b",
      "cosyvoice": "CosyVoice-300M-SFT",
      "qwen3Asr": "Qwen/Qwen3-ASR-1.7B",
      "sensevoice": "iic/SenseVoiceSmall"
    }
  },
  "voice": {
    "default": "JBFqnCBsd6RMkjVDRZzb",
    "aliases": {
      "alloy": "JBFqnCBsd6RMkjVDRZzb",
      "echo": "onwK4e9ZLuTAKqWW03F9",
      "fable": "EXAVITQu4vr4xnSDxMaL",
      "onyx": "pNInz6obpgDQGcFmaJgB",
      "nova": "FGY2WhTYpPnrIDTdsKH5",
      "shimmer": "pFZP5JQG7iQjIQuC4Bku"
    },
    "premadeElevenLabs": {
      "george": "JBFqnCBsd6RMkjVDRZzb",
      "adam": "pNInz6obpgDQGcFmaJgB",
      "bill": "pqHfZKP75CvOlQylNhV4",
      "brian": "nPczCjzI2devNBz1zQrb",
      "callum": "N2lVS1w4EtoT3dr4eOWO",
      "emma": "EXAVITQu4vr4xnSDxMaL",
      "jessica": "cgSgspJ2msm6clMCkdW9",
