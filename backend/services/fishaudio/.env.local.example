# 本机 Fish Audio 语音适配器配置模板
# 复制为同目录 .env.local（已被 gitignore，不会提交）。
# 通用默认值由 start.mjs 从 frontend/src/lib/speech-rules.json 注入，
# 因此此文件只需保留密钥和需要显式覆盖的项。规则说明见 docs/speech-rules.md。

# 必填。在 fish.audio/app/api-keys 获取；只在本机服务进程读取，绝不放入 NEXT_PUBLIC_* 或浏览器配置。
FISH_API_KEY=

# 绑定地址与上游（仅 HTTPS 远端或 loopback HTTP mock）
MOSS_FISHAUDIO_HOST=127.0.0.1
MOSS_FISHAUDIO_PORT=5584
MOSS_FISHAUDIO_ALLOWED_ORIGINS=http://127.0.0.1:5577,http://localhost:5577
MOSS_FISHAUDIO_BASE_URL=https://api.fish.audio

# 当前服务使用的本地模型、音色与实时性档位
# TTS 模型可选 s1 / s2-pro / s2.1-pro / s2.1-pro-free / drama-3-preview；免费档用 s2.1-pro-free。
MOSS_FISHAUDIO_TTS_MODEL=s2.1-pro-free
MOSS_FISHAUDIO_ASR_MODEL=transcribe-1-pro
# 音色是 Fish Audio voice model ID（reference_id）；留空使用 Fish Audio 内置默认音色。
MOSS_FISHAUDIO_DEFAULT_VOICE=
# low | normal | balanced；会话场景建议 balanced。
MOSS_FISHAUDIO_LATENCY=balanced
MOSS_FISHAUDIO_DEFAULT_RESPONSE_FORMAT=mp3

# 通用限制与超时
MOSS_FISHAUDIO_TIMEOUT_SECONDS=45
MOSS_FISHAUDIO_MAX_AUDIO_BYTES=8000000
MOSS_FISHAUDIO_MAX_TEXT_LENGTH=2000

# 可选本机 Bearer token；设置后请在浏览器「API 密钥」字段填同一个值
MOSS_FISHAUDIO_ACCESS_TOKEN=
