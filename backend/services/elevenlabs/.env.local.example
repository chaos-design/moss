# 本机 ElevenLabs 语音适配器配置模板
# 复制为同目录 .env.local（已被 gitignore，不会提交）。
# 通用默认值由 start.mjs 从 frontend/src/lib/speech-rules.json 注入，
# 因此此文件只需保留密钥和需要显式覆盖的项。规则说明见 docs/speech-rules.md。

# 必填。只在本机服务进程读取，绝不放入 NEXT_PUBLIC_* 或浏览器配置。
ELEVENLABS_API_KEY=

# 绑定地址与上游（仅 HTTPS 远端或 loopback HTTP mock）
MOSS_ELEVENLABS_HOST=127.0.0.1
MOSS_ELEVENLABS_PORT=5583
MOSS_ELEVENLABS_ALLOWED_ORIGINS=http://127.0.0.1:5577,http://localhost:5577
MOSS_ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# 当前服务使用的本地模型、音色与默认输出格式
MOSS_ELEVENLABS_TTS_MODEL=eleven_v4
MOSS_ELEVENLABS_ASR_MODEL=scribe_v2
MOSS_ELEVENLABS_DEFAULT_VOICE=JBFqnCBsd6RMkjVDRZzb
MOSS_ELEVENLABS_DEFAULT_RESPONSE_FORMAT=mp3

# 通用限制与超时
MOSS_ELEVENLABS_TIMEOUT_SECONDS=45
MOSS_ELEVENLABS_MAX_AUDIO_BYTES=8000000
MOSS_ELEVENLABS_MAX_TEXT_LENGTH=2000

# 可选本机 Bearer token；设置后请在浏览器「API 密钥」字段填同一个值
MOSS_ELEVENLABS_ACCESS_TOKEN=
