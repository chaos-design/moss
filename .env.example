# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true only after enabling Google in Supabase Auth providers
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=false
# Dedicated confirmed-email accounts used only by pnpm db:test:rls
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
# Server-only admin key used by account deletion and the offline embedding backfill command
SUPABASE_SERVICE_ROLE_KEY=
# Server-only HMAC secret for irreversible account deletion audit fingerprints
ACCOUNT_DELETION_AUDIT_SECRET=
# Optional backfill tuning; defaults are 25 snapshots, 3 attempts, and .tmp/memory-backfill.json
MEMORY_BACKFILL_BATCH_SIZE=25
MEMORY_BACKFILL_RETRY_ATTEMPTS=3
MEMORY_BACKFILL_CHECKPOINT=.tmp/memory-backfill.json

# Explicit local demo mode; keep false in deployed environments
NEXT_PUBLIC_DEMO_MODE=false

# Browser-facing Python TTS service; only loopback URLs are accepted
NEXT_PUBLIC_TTS_SERVICE_URL=http://127.0.0.1:5578
# TTS gateway; keep loopback-only for the browser-local deployment model
MOSS_TTS_HOST=127.0.0.1
MOSS_TTS_PORT=5578
MOSS_TTS_ALLOWED_ORIGINS=http://127.0.0.1:5577,http://localhost:5577
# Optional local Kokoro model overrides
MOSS_KOKORO_MODEL_PATH=backend/services/tts/models/kokoro-v1.0.onnx
MOSS_KOKORO_VOICES_PATH=backend/services/tts/models/voices-v1.0.bin
MOSS_KOKORO_ZH_MODEL_PATH=backend/services/tts/models/kokoro-v1.1-zh.onnx
MOSS_KOKORO_ZH_VOICES_PATH=backend/services/tts/models/voices-v1.1-zh.bin
MOSS_KOKORO_ZH_CONFIG_PATH=backend/services/tts/models/kokoro-v1.1-zh-config.json
# Optional Audio8 multilingual sidecar
MOSS_AUDIO8_URL=http://127.0.0.1:5582
MOSS_AUDIO8_HOST=127.0.0.1
MOSS_AUDIO8_PORT=5582
MOSS_AUDIO8_MODEL_ID=Audio8/Audio8-TTS-Preview-0.6b
MOSS_AUDIO8_MODEL_DIR=backend/services/tts/runtimes/audio8/models/Audio8-TTS-Preview-0.6b
MOSS_AUDIO8_DEVICE=auto
MOSS_AUDIO8_MAX_NEW_TOKENS=1024
# Optional independent CosyVoice sidecar
MOSS_COSYVOICE_URL=http://127.0.0.1:5581
MOSS_COSYVOICE_HOST=127.0.0.1
MOSS_COSYVOICE_PORT=5581
MOSS_COSYVOICE_RUNTIME_DIR=backend/services/tts/runtimes/cosyvoice/runtime
MOSS_COSYVOICE_MODEL_DIR=backend/services/tts/runtimes/cosyvoice/models/CosyVoice-300M-SFT

# Independent switchable Qwen3-ASR / SenseVoice service
NEXT_PUBLIC_ASR_SERVICE_URL=ws://127.0.0.1:5580/v1/asr/stream
# Optional standard FunASR 2-pass WebSocket service
NEXT_PUBLIC_FUNASR_SERVICE_URL=ws://127.0.0.1:10095
# Optional OpenAI-compatible speech endpoints used when the learner selects the HTTP API
# transport in 偏好设置 → 语音服务接入. Public addresses and model names only; API keys stay in
# the browser storage key moss:speech-config:v1.
NEXT_PUBLIC_ASR_API_URL=https://api.openai.com/v1
NEXT_PUBLIC_ASR_API_MODEL=whisper-1
NEXT_PUBLIC_TTS_API_URL=https://api.openai.com/v1
NEXT_PUBLIC_TTS_API_MODEL=tts-1
MOSS_ASR_HOST=127.0.0.1
MOSS_ASR_PORT=5580
MOSS_ASR_ENGINE=sensevoice
# Extra engines to load at startup (CSV) so their first use skips a cold load.
# pnpm dev:offline defaults this to qwen3-asr; leave empty to keep lazy loading.
MOSS_ASR_PRELOAD_ENGINES=
MOSS_ASR_ALLOWED_ORIGINS=http://127.0.0.1:5577,http://localhost:5577
MOSS_ASR_MODEL_ID=Qwen/Qwen3-ASR-1.7B
MOSS_ASR_MODEL_DIR=backend/services/asr/models/Qwen3-ASR-1.7B
MOSS_ASR_MODEL_SOURCE=modelscope
MOSS_SENSEVOICE_MODEL_ID=iic/SenseVoiceSmall
MOSS_SENSEVOICE_MODEL_DIR=backend/services/asr/models/SenseVoiceSmall
MOSS_ASR_DEVICE=auto
# auto: bfloat16 on CPU/CUDA, float16 on Metal. float32 doubles CPU memory and can
# OOM-kill the service on a 16 GB machine. float16 is invalid on CPU.
MOSS_ASR_DTYPE=auto
MOSS_ASR_SAMPLE_RATE=16000
MOSS_ASR_MAX_CONNECTIONS=2
MOSS_ASR_MAX_CHUNK_BYTES=65536
MOSS_ASR_MAX_AUDIO_SECONDS=60
MOSS_ASR_MAX_NEW_TOKENS=256
MOSS_ASR_SPEECH_THRESHOLD=0.018
MOSS_ASR_NOISE_CALIBRATION_SECONDS=0.5
MOSS_ASR_NOISE_THRESHOLD_MULTIPLIER=3.0
MOSS_ASR_MIN_SPEECH_SECONDS=0.35
MOSS_ASR_ENDPOINT_SILENCE_SECONDS=0.85
MOSS_ASR_PRE_ROLL_SECONDS=0.25
# Required when the ASR service is exposed outside a trusted local network
MOSS_ASR_API_KEY=

# Server-only OpenAI-compatible provider configuration
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_NAME=
# Optional: chat-completions or anthropic-messages; inferred from AI_BASE_URL when omitted
AI_API_TYPE=
# Optional maintenance-only fallback used by pnpm expressions:generate
AI_EXPRESSION_FALLBACK_MODEL=
# Production allowlist for browser-provided custom model endpoints (exact hostnames, CSV).
# api.openai.com and api.anthropic.com are always allowed.
AI_ALLOWED_BROWSER_MODEL_HOSTS=
# Production allowlist for browser-provided speech endpoints used by /api/speech/asr and
# /api/speech/tts (exact hostnames, CSV). api.openai.com and api.anthropic.com are always allowed.
AI_ALLOWED_BROWSER_SPEECH_HOSTS=
# Optional: OpenAI-compatible 1536-dimensional embedding model for Supabase RAG
AI_EMBEDDING_MODEL=

# Server-only PKCS#8 DER RSA private key encoded as one-line base64.
# Required for stable encrypted browser model config across production instances.
MODEL_CONFIG_PRIVATE_KEY_BASE64=
